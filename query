-- ===========================================
-- ADDITIONAL USEFUL QUERIES
-- ===========================================

-- Get all cases with client details
SELECT c.id, c.title, c.status, c.nextHearing, cl.name AS client_name, cl.email AS client_email
FROM cases c
JOIN clients cl ON c.client = cl.name;

-- Get all tasks with assigned staff and advocate details
SELECT t.id, t.title, t.status, s.name AS staff_name, a.name AS advocate_name, cl.name AS client_name
FROM tasks t
JOIN staff s ON t.assigned_to = s.id
JOIN advocates a ON t.assigned_by = a.id
LEFT JOIN clients cl ON t.client_id = cl.id;

-- Get total invoice amount by client
SELECT client, SUM(amount) AS total_amount
FROM invoices
GROUP BY client;

-- Get count of tasks by status
SELECT status, COUNT(*) AS task_count
FROM tasks
GROUP BY status;

-- Get messages from last 7 days
SELECT * FROM messages
WHERE date >= DATE_SUB(CURDATE(), INTERVAL 7 DAY);

-- Get staff under a specific advocate
SELECT s.name, s.email, s.role
FROM staff s
WHERE s.advocate_id = 1;
